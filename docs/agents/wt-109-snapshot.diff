+  assert.ok(V.rowHtml({ applyChannel: ["visit"], applyPlaceText: "주민센터 또는 <정부24>" }).includes("주민센터 또는 &lt;정부24&gt;"));
+  const h = V.rowHtml({ applyChannel: ["healthCenter", "visit", "visit"] }); assert.ok(h.includes("보건소 · 방문") && h.includes("신청하는 곳"));

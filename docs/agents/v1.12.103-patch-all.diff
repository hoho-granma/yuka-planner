+  // acct36Is3to5 판정 추출 실행: 36개월 미만·임신·초등은 false, 3~5세는 true
+  const i = app.indexOf("  function acct36Is3to5() {"), fn = app.slice(i, app.indexOf("\n  }\n", i) + 4);

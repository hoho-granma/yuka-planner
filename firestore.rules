// 한눈육아 Firestore 보안 규칙 (v2 스키마용)
//
// 아직 배포하지 않았다 — 이 리포에 firestore.rules가 없었다는 것이
// docs/Firestore-스키마-설계.md 섹션 10에서 지적한 가장 큰 위험이었다.
// 배포(firebase deploy --only firestore:rules)는 사용자 승인 후 별도로 진행한다.
//
// 설계 원칙(docs/Firestore-스키마-설계.md 섹션 10과 동일):
//   - 어떤 collection도 조건 없는 list(전체 열람)를 허용하지 않는다.
//     예외: family 서브트리 내부(children, completions)의 list는 허용한다 —
//     그 쿼리를 구성하려면 이미 familyId/childId를 알아야 하므로,
//     "무작위로 전체를 훑는" 것과는 다른 상황이다.
//   - collection-group 쿼리(예: 모든 family의 completions를 한번에 훑는 것)에 대한
//     규칙은 의도적으로 넣지 않는다 → 규칙이 없으면 기본적으로 거부된다.
//   - "가족코드를 아는 사람 = 그 가족 데이터를 볼 권한이 있는 사람"이라는 제품 정책은
//     familyCodes 조회를 통해서만 familyId를 얻을 수 있게 하는 것으로 구현한다.
//     familyId 자체를 어떻게든 알아낸 사람을 막는 방법은 Firestore 규칙만으로는 없다
//     (Firestore Rules로 해결 불가능한 부분 — docs 참고, 아래에도 명시).

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // familyCodes/{code} — 코드→familyId 조회 및 코드 유일성 보장 전용
    // ---------------------------------------------------------------
    match /familyCodes/{code} {
      // 정확한 코드 문자열을 아는 클라이언트만 get 가능(코드 자체가 자격증명).
      allow get: if true;

      // 전체 코드 목록을 훑는 것은 절대 금지 — 이게 열려 있으면 6자리 코드의
      // 엔트로피(32^6)가 전혀 의미 없어진다.
      allow list: if false;

      // 신규 코드 발급: 필요한 필드만, active=true로만 생성 가능.
      // "이미 존재하는 코드 문서를 덮어써서 다른 가족의 코드를 가로채는" 것을
      // create 규칙(문서가 없을 때만 성립)으로 원천 차단한다.
      allow create: if request.resource.data.keys().hasOnly(['familyId', 'active', 'createdAt', 'revokedAt'])
                    && request.resource.data.active == true
                    && request.resource.data.familyId is string;

      // 재발급 시 기존 코드를 비활성화하는 것만 허용(active, revokedAt 두 필드만 변경 가능).
      // familyId 자체는 한 번 만들어지면 바꿀 수 없다(다른 가족 코드로 탈취 방지).
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'revokedAt'])
                    && request.resource.data.familyId == resource.data.familyId;

      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // families/{familyId} — 가족 단위 데이터
    //   ※ 레거시 v1 문서(families/{code}, profile+completed 통짜)도 같은
    //     컬렉션에 당분간 공존한다. 문서ID 형태(6자 코드 vs Firestore auto-id)만
    //     다를 뿐 규칙은 동일하게 적용된다 — 레거시 문서도 "문서ID(=코드)를 아는
    //     사람만 접근 가능"이라는 지금까지의 동작과 동일하므로 회귀(regression)가 아니다.
    // ---------------------------------------------------------------
    match /families/{familyId} {
      allow get: if true; // familyId를 아는 것 자체가 자격 증명(설계상 감수하는 지점, 문서 참고)
      allow list: if false; // 전체 family 목록 열람 금지 — 가장 중요한 규칙

      // 레거시(v1, js/sync.js createFamily())와 v2(js/sync-v2.js createFamilyV2())가
      // 같은 최상위 families 컬렉션을 공유한다(문서 ID 형태만 다름 — 6자 코드 vs auto-id).
      // 두 쓰기 패턴을 모두 허용해야 기존 서비스가 안 깨진다.
      allow create: if
        // v1: createFamily()가 실제로 쓰는 필드 그대로 — { profile, completed, updatedAt }
        (request.resource.data.keys().hasOnly(['profile', 'completed', 'updatedAt'])
          && request.resource.data.profile is map)
        ||
        // v2: createFamilyV2()가 쓰는 필드
        (request.resource.data.keys().hasAll(['currentCode', 'province', 'district'])
          && request.resource.data.currentCode is string);

      allow update: if
        // 레거시: updateProfile()은 {profile, updatedAt}만, updateCompleted()는 {completed, updatedAt}만,
        // updateRecord()(UX 개편: 직접 작성한 성장·활동 기록)는 {records.<id>, updatedAt}만 쓴다.
        // merge:true로 쓴다(js/sync.js). archived/migratedTo/migratedAt은 마이그레이션 시 레거시 문서에
        // 표시하는 필드라 여기 같이 허용한다(docs/Firestore-마이그레이션-계획.md).
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['profile', 'completed', 'records', 'updatedAt', 'archived', 'migratedTo', 'migratedAt'])
        ||
        // v2
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['province', 'district', 'familyDeclaredAttributes', 'currentCode', 'updatedAt', 'archived', 'migratedTo', 'migratedAt']);

      allow delete: if false; // 삭제는 이번 단계 기능이 아님(기존 데이터 보존 원칙)

      // -------------------------------------------------------------
      // families/{familyId}/children/{childId} — 아이 프로필
      // -------------------------------------------------------------
      match /children/{childId} {
        // list 허용 이유: 이 경로 자체가 이미 familyId를 요구하므로,
        // "이 가족의 자녀 목록"을 보는 것이지 "전체 서비스의 자녀 목록"이 아니다.
        allow get, list: if true;

        allow create: if request.resource.data.keys().hasAll(['birthDate']);
        allow update: if request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['birthDate', 'gender', 'childDeclaredAttributes', 'updatedAt']);
        allow delete: if false;

        // -----------------------------------------------------------
        // .../completions/{completionId} — CompletionRecord
        // -----------------------------------------------------------
        match /completions/{completionId} {
          // list 허용 이유: children과 동일 — 이미 familyId+childId를 아는 경로.
          allow get, list: if true;

          // 문서 ID가 반드시 "todo_id__occurrenceKey__recordType" 합성키와
          // 일치해야만 생성 가능 — 임의의 ID로 데이터를 채우는 것을 방지하고
          // upsert(같은 조합=같은 문서)를 규칙 수준에서 강제한다.
          allow create: if request.resource.data.keys().hasAll(['todo_id', 'occurrenceKey', 'recordType', 'recordedAt'])
                        && request.resource.data.recordType in ['MILESTONE_REPORTED', 'TODO_COMPLETED']
                        && completionId == request.resource.data.todo_id + '__' + request.resource.data.occurrenceKey + '__' + request.resource.data.recordType;

          // 완료 기록 수정은 recordedAt 정정 정도만 허용(핵심 식별 필드는 변경 불가).
          allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recordedAt', 'createdAt'])
                        && request.resource.data.todo_id == resource.data.todo_id
                        && request.resource.data.occurrenceKey == resource.data.occurrenceKey
                        && request.resource.data.recordType == resource.data.recordType;

          allow delete: if false;
        }
      }
    }

    // 그 외 모든 경로: 기본 거부(명시하지 않으면 Firestore 규칙은 기본적으로 거부한다).
    // TodoDefinition/지역/지원금 데이터는 Firestore에 두지 않으므로 여기에 규칙이 없다
    // (docs/Firestore-스키마-설계.md 섹션 7).
  }
}

// ---------------------------------------------------------------------
// Firestore Rules만으로 해결되지 않는 것 (임의로 해결됐다고 가정하지 않는다)
// ---------------------------------------------------------------------
// 1. familyCodes 문서 생성 자체를 아무나 무제한으로 반복할 수 있다(스팸/쿼터 소모 공격).
//    인증이 없는 구조라 Rules만으로 요청자를 구분할 방법이 없다.
//    완화책은 Firebase App Check 도입인데, 이번 단계 범위 밖이라 적용하지 않았다.
// 2. 6자리 코드를 무작위로 순차 시도(brute force)하는 것 자체는 Rules로 막을 수 없다
//    (Rules는 요청 하나하나를 개별 판단할 뿐 요청 빈도를 모른다).
//    App Check 또는 Cloud Functions 기반 rate limit이 필요하며 이번 단계에서 다루지 않는다.
// 3. familyId(Firestore auto-id)를 어떤 경로로든 알아낸 제3자는 규칙상 정상 접근자와
//    구분되지 않는다 — "코드를 아는 사람=접근 권한이 있는 사람"이라는 제품 정책 자체가
//    그렇게 설계됐기 때문이며, 진짜 사용자 인증이 도입되기 전까지는 구조적 한계다.
